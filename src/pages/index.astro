---
import { getCollection } from "astro:content";
import ArticleCard from "../components/ArticleCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { sortArticlesDesc } from "../lib/articles";
import { withBase } from "../lib/paths";

const articles = (await getCollection("articles")).sort(sortArticlesDesc);
const latestArticles = articles.slice(0, 3);
---

<SiteLayout
  title="Disciplinary Inquiries into Casual Knowledge (DICK)"
  description="A scholarly journal examining informal expertise, everyday knowledge, and overlooked cultural practices."
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-panel hero-panel--main">
        <span class="eyebrow">Volume 1 · 2025</span>
        <h1 class="hero-title">Disciplinary Inquiries into Casual Knowledge</h1>
        <p class="hero-tagline">
          A peer-reviewed journal for rigorous research into informal expertise, everyday knowledge, and cultural
          practices often overlooked by traditional scholarship.
        </p>
        <div class="cta-row" aria-label="Primary actions">
          <a class="button" href={withBase("submit/")}>Submit a manuscript</a>
          <a class="text-link" href={withBase("articles/")}>Browse all articles</a>
        </div>
      </div>

      <div class="hero-stats">
        <aside class="stat-card" aria-labelledby="editorial-focus-heading">
          <h2 id="editorial-focus-heading">About the journal</h2>
          <p>
            We publish empirical studies, methods papers, and critical perspectives. Our subject matter may be
            unconventional; our standards for evidence, ethics, and reproducibility are not.
          </p>
          <nav class="journal-links" aria-label="Journal information">
            <a href={withBase("aims/")}>Aims &amp; Scope</a>
            <a href={withBase("policies/")}>Editorial policies</a>
            <a href={withBase("team/")}>Editorial team</a>
          </nav>
        </aside>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">Latest Articles</span>
          <h2 class="section-title">Current issue</h2>
        </div>
        <a class="text-link" href={withBase("articles/")}>View archive</a>
      </div>

      <div class="article-grid">
        {latestArticles.map((article) => (
          <ArticleCard article={article} compact={true} showAbstract={true} />
        ))}
      </div>
    </div>
  </section>
</SiteLayout>
